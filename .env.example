# Frontend (safe public anon key, protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_BASE_URL=https://YOUR_WORKER.workers.dev
# Set to d1 only when the Cloudflare Worker preview is ready. Leave unset to use Supabase.
VITE_BACKEND=supabase
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# Set to true only during an incident to stop browser requests before they
# reach Supabase. Never commit a real environment file.
VITE_MAINTENANCE_MODE=false

# Worker secrets — add with `wrangler secret put ...`, never commit real values
TMDB_BEARER_TOKEN=
YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=
