# Local Worker development only. Copy to .dev.vars; never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
APP_ORIGIN=http://localhost:5173

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.6
OPENAI_VISION_MODEL=gpt-5.6

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8787/api/calendar/callback
CALENDAR_STATE_SECRET=GENERATE_A_RANDOM_SECRET
TOKEN_ENCRYPTION_KEY=GENERATE_A_RANDOM_SECRET

# Optional richer media in book enrichment.
TMDB_BEARER_TOKEN=
YOUTUBE_API_KEY=

# NYT Books API (server-side only)
NYT_BOOKS_API_KEY=your_nyt_books_api_key

# Protects bounded maintenance routes such as Goodreads cover backfill.
MAINTENANCE_SECRET=replace-with-a-long-random-secret
